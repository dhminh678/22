<?xml version="1.0" encoding="utf-8"?>
<!--
  5 tab chính. Tab chưa làm dùng PlaceholderFragment.
  Chủ mảng thay android:name bằng Fragment thật của mình (giữ nguyên android:id).
    composeFragment   -> D (F3 nhập topic + F2 tiến độ agent của C)
    postsFragment     -> D (F4 duyệt bài) + A (F5 trạng thái đăng)
    commentsFragment  -> B (F6)
    analyticsFragment -> D (F7)
    settingsFragment  -> A (F9), từ đây mở Kênh của tôi (B, F1) và API key (C, F8)
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/composeFragment">

    <fragment
        android:id="@+id/composeFragment"
        android:name="com.lttbdd.socialagent.feature.compose.ComposeFragment"
        android:label="@string/nav_compose">
    </fragment>

    <fragment
        android:id="@+id/postsFragment"
        android:name="com.lttbdd.socialagent.core.ui.PlaceholderFragment"
        android:label="@string/nav_posts">
        <argument
            android:name="titleRes"
            android:defaultValue="@string/nav_posts"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/commentsFragment"
        android:name="com.lttbdd.socialagent.core.ui.PlaceholderFragment"
        android:label="@string/nav_comments">
        <argument
            android:name="titleRes"
            android:defaultValue="@string/nav_comments"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.lttbdd.socialagent.core.ui.PlaceholderFragment"
        android:label="@string/nav_analytics">
        <argument
            android:name="titleRes"
            android:defaultValue="@string/nav_analytics"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.lttbdd.socialagent.feature.settings.SettingsFragment"
        android:label="@string/nav_settings">
        <action
            android:id="@+id/action_settings_to_api_keys"
            app:destination="@id/apiKeysFragment" />
        <action
            android:id="@+id/action_settings_to_channels"
            app:destination="@id/channelFragment" />
        <action
            android:id="@+id/action_settings_to_model_selection"
            app:destination="@id/modelSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/apiKeysFragment"
        android:name="com.lttbdd.socialagent.feature.apikeys.ApiKeysFragment"
        android:label="@string/api_keys_title" />

    <!-- Chọn model theo loại việc (F8, #54) mở từ Cài đặt. -->
    <fragment
        android:id="@+id/modelSelectionFragment"
        android:name="com.lttbdd.socialagent.feature.models.ModelSelectionFragment"
        android:label="@string/models_title">
        <action
            android:id="@+id/action_model_selection_to_api_keys"
            app:destination="@id/apiKeysFragment" />
    </fragment>

    <!-- Kênh của tôi (B, F1) mở từ Cài đặt. -->
    <fragment
        android:id="@+id/channelFragment"
        android:name="com.lttbdd.socialagent.feature.channel.ChannelFragment"
        android:label="@string/channel_title" />

</navigation>
