# Sao chép thành .env hoặc đặt trong biến môi trường của hosting. KHÔNG commit file chứa giá trị thật.
LINKEDIN_MEMBER_CLIENT_ID=your_linkedin_member_client_id
LINKEDIN_MEMBER_CLIENT_SECRET=your_linkedin_member_client_secret
# URL công khai (HTTPS) của BFF, không có dấu / ở cuối. Phải trùng Redirect URL đã đăng ký ở LinkedIn: {BFF_PUBLIC_URL}/auth/linkedin/callback
BFF_PUBLIC_URL=https://your-bff.example.com
# Nơi BFF chuyển hướng trình duyệt về app (custom scheme hoặc Android App Link). Cố định ở server, không nhận từ request.
APP_REDIRECT_URI=com.lttbdd.socialagent://oauth/linkedin/callback
PORT=8787
